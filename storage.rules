rules_version = '2';

// Deploy with `firebase deploy --only storage`, or paste into the Firebase
// console under Storage > Rules. Each signed-in user can only read/write
// their own backup file — nobody else's, and not while signed out.
service firebase.storage {
  match /b/{bucket}/o {
    match /backups/{uid}/{fileName} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
