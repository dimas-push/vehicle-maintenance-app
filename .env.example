# Copy this file to .env and fill in values from your Firebase project
# (Firebase console > Project settings > General > Your apps > SDK setup and
# configuration). These are safe to embed in the client bundle — Firebase's
# web config is not a secret, access is controlled by Firestore/Auth security
# rules, not by hiding these values. Still gitignored to keep per-project
# values out of source control.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
